{
  "name": "afemspectra",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  // Birkaç hafta sonra false yapılabilir. Eski adresteki 301 o zaman sona erer.
  "workers_dev": true,
  "routes": [
    { "pattern": "afemspectra.ferdibirgul.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 5, "period": 60 }
      }
    ]
  }
}
